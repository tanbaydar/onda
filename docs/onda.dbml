Project onda {
  database_type: "MySQL"
  Note: '''
  Authoritative frozen product ERD for Onda.
  Target database: MySQL 8.0.16+ so CHECK constraints are enforced.
  Django implementation note: ONDA_USER will extend AbstractUser. Framework-added
  administrative columns and permission tables carry no product semantics and are
  intentionally omitted from this product ERD; product code must not depend on them.
  '''
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

Enum sync_run_type {
  nightly
  backfill
  replay
}

Enum sync_run_status {
  running
  completed
  crashed
}

Enum raw_processing_status {
  pending
  processed
  failed
}

Enum rejection_reason {
  OUT_OF_SCOPE
  NO_ARTIST
  EMPTY_TITLE
  BAD_DATE
  PARSE_FAILURE
}

Enum event_status {
  active
  unverified
  hidden
}

Enum user_status {
  active
  deactivated
  pending_deletion
}

Enum follow_status {
  pending
  approved
}

Enum account_code_purpose {
  email_verification
  password_reset
}

Enum notification_type {
  review_like
  follow
  follow_request
  request_accepted
}

Enum report_target_type {
  review
  profile
}

// ---------------------------------------------------------------------------
// INGESTION
// ---------------------------------------------------------------------------

Table TRACKED_SOURCE_PAGE {
  id bigint [pk, increment]
  source varchar(50) [not null, note: "Lowercase code-level registry value; v1 canonical value is 'ra'."]
  area_ref varchar(255) [not null, note: "Provider area identifier; RA seeds: NYC=8, Boston=530."]
  label varchar(100) [not null]
  active boolean [not null, default: true]
  last_synced_at datetime [null, note: "NULL = this seed has never completed an attempted sync."]
  last_success_at datetime [null, note: "NULL = this seed has never completed a successful sync."]

  indexes {
    (source, area_ref) [unique, name: "uq_tracked_source_area"]
  }

  Note: "Request construction belongs to the source fetcher, not to seed rows."
}

Table SYNC_RUN {
  id bigint [pk, increment]
  run_type sync_run_type [not null]
  status sync_run_status [not null]
  started_at datetime [not null]
  finished_at datetime [null, note: "NULL = run is still running or crashed before finalization."]
  seeds_attempted int [not null, default: 0]
  seeds_failed int [not null, default: 0]
  events_upserted int [not null, default: 0]
  events_quarantined int [not null, default: 0]
  events_dropped int [not null, default: 0]
  error_summary text [null, note: "NULL = no run-level error summary."]

  Note: '''
  Counters are immutable completion-time execution telemetry, not catalog truth.
  Replays are executions and receive their own run rows. A crashed run preserves
  whatever partial telemetry was known.
  '''
}

Table RAW_INGEST {
  id bigint [pk, increment]
  seed_id bigint [not null, ref: > TRACKED_SOURCE_PAGE.id]
  run_id bigint [not null, ref: > SYNC_RUN.id]
  window_start date [null, note: "NULL = request supplied no lower date bound."]
  window_end date [null, note: "NULL = request supplied no upper date bound."]
  page_number int [not null]
  page_size int [not null]
  response_body longtext [null, note: "Exact response body as text; NULL = no body was received."]
  http_status smallint [null, note: "NULL = no HTTP response was received."]
  fetched_at datetime [not null]
  processing_status raw_processing_status [not null, default: "pending"]

  indexes {
    run_id [name: "ix_raw_ingest_run"]
    (seed_id, fetched_at) [name: "ix_raw_ingest_seed_fetched"]
  }

  Note: '''
  One row equals one HTTP request/response boundary. The raw layer performs no JSON
  validation. LONGTEXT deliberately gives up database-native JSON querying so HTML,
  plaintext, truncated, and otherwise invalid responses remain replayable evidence.
  processing_status.failed is a payload-grain Transformer verdict.
  RAW_INGEST is append-only and is never deleted in v1.
  '''
}

Table REJECTED_INGEST {
  id bigint [pk, increment]
  raw_ingest_id bigint [not null, ref: > RAW_INGEST.id]
  entity_index int [not null, note: "Zero-based position of the event in the payload's listing array. Always known; locates the rejected observation."]
  entity_ref varchar(255) [null, note: "NULL = the listed event carried no usable provider event ID; when present, always the nested event.id, never the listing-wrapper id."]
  reason rejection_reason [not null]
  detail text [null, note: "NULL = reason enum fully describes the rejection."]
  rejected_at datetime [not null]

  indexes {
    (raw_ingest_id, entity_index) [unique, name: "uq_rejection_payload_index"]
  }

  Note: '''
  Immutable rejection occurrence: one entity verdict in one raw response. Replay uses
  insert-or-ignore against the raw-ingest/index unique key. PARSE_FAILURE means an
  event-level structural failure within a parseable payload. entity_ref may be NULL when
  the listed event carried no usable provider event ID. Whole-payload parse failure
  belongs on RAW_INGEST.processing_status.

  Current-state derivation:
  - quarantined: latest observation rejected and no EVENT_IDENTITY mapping exists;
  - degraded: latest observation rejected but EVENT_IDENTITY already exists;
  - attempt_count = COUNT(*); first_seen_at = MIN(rejected_at).
  OUT_OF_SCOPE alone is dropped. Every quality failure (NO_ARTIST, EMPTY_TITLE,
  BAD_DATE, PARSE_FAILURE) is quarantined and retried on later observations.
  '''
}

// ---------------------------------------------------------------------------
// CANONICAL + IDENTITY
// ---------------------------------------------------------------------------

Table CITY {
  id bigint [pk, increment]
  name varchar(120) [not null]
  region_code varchar(20) [null, note: "Always present for v1 US rows; future non-US rows use a curated sentinel when regions do not apply."]
  region_name varchar(120) [null, note: "NULL = no expanded administrative-region label stored."]
  country_code char(2) [not null, note: "ISO 3166-1 alpha-2; constant US for all v1 data."]
  timezone varchar(64) [not null, note: "IANA timezone identifier."]

  indexes {
    (country_code, region_code, name) [unique, name: "uq_city_country_region_name"]
  }

  Note: "V1 data is US-only. Schema is international-tolerant; international behavior is neither built nor tested."
}

Table VENUE {
  id bigint [pk, increment]
  name varchar(255) [not null]
  city_id bigint [not null]

  Note: "Venue granularity equals provider granularity verbatim. Grouping is future, requirements-first work."
}

Table ARTIST {
  id bigint [pk, increment]
  name varchar(255) [not null, note: "Deliberately non-unique; external identity distinguishes same-name artists."]
  image_url varchar(2048) [null, note: "NULL = no artist image is available."]
}

Table EVENT {
  id bigint [pk, increment]
  title varchar(500) [not null]
  event_date date [not null]
  start_time time [null, note: "NULL = source supplied no time; loggable at 00:00 venue-local on event_date."]
  venue_id bigint [not null]
  cover_image_url varchar(2048) [null, note: "NULL = app uses its default event image."]
  status event_status [not null, default: "active"]

  indexes {
    (status, event_date) [name: "ix_event_status_date"]
    (venue_id, event_date) [name: "ix_event_venue_date"]
  }

  Note: '''
  EVENT is never deleted; all incoming canonical references use ON DELETE RESTRICT.
  Status values are exactly active, unverified, hidden; there is no cancelled state.

  Cross-table absence rule:
  - each EVENT_IDENTITY increments misses only when a successful, complete covering
    fetch omits it; presence resets misses to 0 and updates last_seen_at;
  - EVENT is hidden when every identity has misses >= 3;
  - EVENT is unverified when every identity has misses >= 1;
  - otherwise EVENT is active.
  With one source, "every identity" degenerates to the single RA identity.
  '''
}

Table EVENT_ARTIST {
  event_id bigint [not null]
  artist_id bigint [not null]
  position int [not null, note: "1-based provider presentation order; mutable and carries no importance semantics."]

  indexes {
    (event_id, artist_id) [pk, name: "pk_event_artist"]
    (event_id, position) [unique, name: "uq_event_artist_position"]
  }

  Note: '''
  Lineup updates delete and reinsert this event's rows atomically to avoid temporary
  position collisions. Artist-page lookup deliberately relies on InnoDB's FK-backing
  artist_id index; add (artist_id, event_id) only if profiling later requires it.
  '''
}

Table EVENT_IDENTITY {
  id bigint [pk, increment]
  event_id bigint [not null]
  source varchar(50) [not null, note: "Lowercase code-level registry value."]
  source_id varchar(255) [not null]
  last_seen_at datetime [null, note: "NULL = identity has not completed a successful observed presence."]
  misses int [not null, default: 0, note: "Consecutive complete successful covering fetches that omitted this identity."]

  indexes {
    (source, source_id) [unique, name: "uq_event_identity_external"]
    (event_id, source) [unique, name: "uq_event_identity_canonical_source"]
  }

  Note: "ON DELETE CASCADE from EVENT is belt-and-suspenders; EVENT deletion is forbidden by inbound RESTRICT references."
}

Table VENUE_IDENTITY {
  id bigint [pk, increment]
  venue_id bigint [not null]
  source varchar(50) [not null, note: "Lowercase code-level registry value."]
  source_id varchar(255) [not null]

  indexes {
    (source, source_id) [unique, name: "uq_venue_identity_external"]
    (venue_id, source) [unique, name: "uq_venue_identity_canonical_source"]
  }
}

Table ARTIST_IDENTITY {
  id bigint [pk, increment]
  artist_id bigint [not null]
  source varchar(50) [not null, note: "Lowercase code-level registry value."]
  source_id varchar(255) [not null]

  indexes {
    (source, source_id) [unique, name: "uq_artist_identity_external"]
    (artist_id, source) [unique, name: "uq_artist_identity_canonical_source"]
  }
}

Table CITY_IDENTITY {
  id bigint [pk, increment]
  city_id bigint [not null]
  source varchar(50) [not null, note: "Lowercase code-level registry value."]
  source_id varchar(255) [not null, note: "Provider area identifier; equals TRACKED_SOURCE_PAGE.area_ref for seed-grain city resolution."]

  indexes {
    (source, source_id) [unique, name: "uq_city_identity_external"]
    (city_id, source) [unique, name: "uq_city_identity_canonical_source"]
  }

  Note: '''
  The captured listing and detail shapes expose no venue-area reference. Before a seed
  is fetched, the runner resolves (seed.source, seed.area_ref) through this table.
  A missing mapping is a configuration defect that fails the seed loudly; it is never
  an event-level quarantine.
  '''
}

// Concrete identity FK delete behavior.
Ref: EVENT_IDENTITY.event_id > EVENT.id [delete: cascade]
Ref: VENUE_IDENTITY.venue_id > VENUE.id [delete: cascade]
Ref: ARTIST_IDENTITY.artist_id > ARTIST.id [delete: cascade]
Ref: CITY_IDENTITY.city_id > CITY.id [delete: cascade]

// ---------------------------------------------------------------------------
// APP
// ---------------------------------------------------------------------------

Table ONDA_USER {
  id bigint [pk, increment]
  email varchar(254) [not null, unique, note: "Case-insensitive uniqueness; reserved from registration until verified or expired unverified account is purged."]
  email_verified_at datetime [null, note: "NULL = registration email has not been verified; account remains read-only."]
  password_hash varchar(128) [not null, note: "Django framework-encoded password hash; never plaintext."]
  username varchar(30) [null, unique, note: "Current namespace claim; lowercase and case-insensitively unique. NULL only in hidden lifecycle states."]
  recovery_username varchar(30) [null, note: "Non-binding memory used during reactivation; deliberately non-unique."]
  display_name varchar(50) [not null]
  bio varchar(150) [null, note: "NULL = user has not supplied a bio."]
  avatar varchar(2048) [null, note: "NULL = default avatar is displayed."]
  home_city_id bigint [null, note: "NULL = no home city selected."]
  is_private boolean [not null, note: "No database default; signup must explicitly choose Public or Private."]
  status user_status [not null, default: "active"]
  deletion_due_at datetime [null, note: "NULL = permanent deletion is not scheduled."]
  created_at datetime [not null]

  Note: '''
  Enforced CHECKS:
    username IS NULL iff status IN ('deactivated', 'pending_deletion');
    deletion_due_at IS NOT NULL iff status = 'pending_deletion'.
  Active rows must claim a username; deactivated/pending-deletion rows must release it.
  Only pending-deletion rows carry a deletion deadline. Reactivation must clear it in
  the same write; shortening the waiting period updates it while status is unchanged.
  Deactivation atomically copies username to recovery_username then clears username.
  Reactivation restores it only if available, otherwise a new username is required.

  Service validation:
  - username format: 3-30 lowercase letters/numbers/underscores/periods, begins and
    ends alphanumeric, no consecutive periods;
  - display_name stores full-whitespace-trimmed 1-50 visible characters.
  '''
}

Table USERNAME_HOLD {
  id bigint [pk, increment]
  username varchar(30) [not null, unique, note: "Case-insensitive; held only after rename."]
  user_id bigint [not null]
  held_until datetime [not null]

  Note: '''
  Rename creates a 30-day hold. Deactivation and pending deletion create no hold.
  Username is claimable iff absent from ONDA_USER.username and from every unexpired
  USERNAME_HOLD. recovery_username is memory, never a reservation.
  '''
}

Table ACCOUNT_CODE {
  id bigint [pk, increment]
  user_id bigint [not null]
  purpose account_code_purpose [not null]
  code_hash varchar(64) [not null]
  sent_at datetime [not null]
  expires_at datetime [not null]
  failed_attempts smallint [not null, default: 0]
  consumed_at datetime [null]

  indexes {
    (user_id, purpose) [unique, name: "uq_account_code_user_purpose"]
  }

  Note: '''
  Shared six-digit-code lifecycle authorized by the PRODUCT_QA_SPEC amendment for
  email verification and password reset. One live lifecycle row exists per user and
  purpose. Codes expire after 15 minutes, permit at most five failed attempts, and
  may be resent after a 60-second cooldown. Successful consumption records
  consumed_at; successful password reset also invalidates existing sessions.

  Enforced CHECKs:
  - failed_attempts <= 5;
  - expires_at > sent_at.
  '''
}

Table FOLLOW {
  follower_id bigint [not null]
  followee_id bigint [not null]
  status follow_status [not null]
  created_at datetime [not null, note: "Immutable initiation time for the request or public follow."]
  approved_at datetime [null, note: "When the relationship became approved; NULL while pending."]

  indexes {
    (follower_id, followee_id) [pk, name: "pk_follow"]
    (followee_id, status) [name: "ix_follow_followee_status"]
  }

  Note: '''
  Enforced CHECKs:
  - follower_id <> followee_id;
  - status = approved iff approved_at IS NOT NULL.
  Public follow inserts approved with created_at = approved_at. Private follow inserts
  pending with approved_at NULL. Approval preserves created_at and sets approved_at to
  the true transition time; reject/unfollow deletes the row. Re-follow creates a new
  row with new lifecycle timestamps. Public->private changes no approved rows.
  Private->public bulk-approves incoming pending rows at one true transition timestamp
  and inserts one request_accepted notification per requester in the same transaction.
  Follow creation and privacy transition serialize by locking the target user row.
  '''
}

Table DIARY_ENTRY {
  id bigint [pk, increment]
  user_id bigint [not null]
  event_id bigint [not null]
  rating decimal(2,1) [null, note: "NULL = valid unrated Been entry; excluded from averages/distributions."]
  rated_at datetime [null, note: "When the current rating was first set; edits preserve it, remove/re-rate resets it."]
  created_at datetime [not null, note: "When attendance was first recorded; immutable."]

  indexes {
    (user_id, event_id) [unique, name: "uq_diary_user_event"]
  }

  Note: '''
  Enforced CHECKs:
  - rating IS NULL iff rated_at IS NULL;
  - rating is NULL or is 0.5 through 5.0 in half-star increments.
  Initial Been creation must include a rating (service transaction invariant).
  Derived Been-feed timestamp = rated_at, so edits remain in place, removal disappears,
  and a later re-rate creates fresh feed activity.
  '''
}

Table REVIEW {
  id bigint [pk, increment]
  entry_id bigint [not null, unique]
  body varchar(1000) [not null]
  published_at datetime [not null, note: "Immutable original publication time used by Newest/Oldest sorts."]

  Note: '''
  Service normalizes and stores full-whitespace-trimmed body. Schema CHECK
  CHAR_LENGTH(TRIM(body)) >= 1 is only a lower-bound backstop because MySQL TRIM
  strips spaces, not all whitespace. Review edit time is deliberately not stored.
  '''
}

Table REVIEW_LIKE {
  user_id bigint [not null]
  review_id bigint [not null]
  created_at datetime [not null]

  indexes {
    (user_id, review_id) [pk, name: "pk_review_like"]
  }

  Note: '''
  Self-like prohibition is a service transaction invariant because it crosses through
  REVIEW -> DIARY_ENTRY. Per-review counts deliberately rely on InnoDB's FK-backing
  review_id index; no counter is stored.
  '''
}

Table WILL_BE_THERE {
  user_id bigint [not null]
  event_id bigint [not null]
  created_at datetime [not null, note: "Derived WBT feed timestamp."]

  indexes {
    (user_id, event_id) [pk, name: "pk_will_be_there"]
  }

  Note: '''
  No stored expiry. One shared service predicate determines write eligibility, read
  visibility, and cleanup eligibility: venue-local time is before midnight following
  EVENT.event_date. Reads enforce logical expiration immediately; cleanup deletion is
  storage hygiene only. Rescheduling therefore changes liveness without row updates.
  Hidden events suppress WBT on implemented surfaces and feeds but preserve the row;
  resurrection restores its visibility. Owner-profile display of hidden-event WBT is
  a planned post-M4 surface that requires the already-recorded product amendment; it
  is not current behavior. WBT and Been may coexist.
  '''
}

Table FAVORITE_EVENT {
  user_id bigint [not null]
  event_id bigint [not null]
  added_at datetime [not null, note: "Profile order ASC; derived favorite-event feed timestamp."]

  indexes {
    (user_id, event_id) [pk, name: "pk_favorite_event"]
  }

  Note: "Maximum three per user, enforced transactionally by the service."
}

Table FAVORITE_ARTIST {
  user_id bigint [not null]
  artist_id bigint [not null]
  added_at datetime [not null, note: "Profile order ASC; derived favorite-artist feed timestamp."]

  indexes {
    (user_id, artist_id) [pk, name: "pk_favorite_artist"]
  }

  Note: "Maximum three per user, enforced transactionally by the service."
}

Table FAVORITE_VENUE {
  user_id bigint [not null]
  venue_id bigint [not null]
  added_at datetime [not null]

  indexes {
    (user_id, venue_id) [pk, name: "pk_favorite_venue"]
  }

  Note: '''
  Uncapped and always private. Venue favorites create no feed activity.
  Favorite-driven event notifications are deferred from MVP because the closed
  notification delivery specification does not define them.
  '''
}

Table NOTIFICATION {
  id bigint [pk, increment]
  recipient_id bigint [not null]
  actor_id bigint [not null]
  type notification_type [not null]
  review_id bigint [null]
  created_at datetime [not null]
  read_at datetime [null, note: "NULL = unread."]

  indexes {
    (recipient_id, created_at) [name: "ix_notif_recipient_created"]
    (recipient_id, read_at) [name: "ix_notification_recipient_read"]
  }

  Note: '''
  Enforced CHECKs:
  - actor_id <> recipient_id (tripwire for upstream self-action bugs);
  - type = review_like iff review_id IS NOT NULL.
  Notifications record actions, not current state: unlike/unfollow does not retract
  history, and repeated actions may create repeated notifications. Account deletion
  cascades both the owner's inbox and notifications about that actor.
  '''
}

Table REPORT {
  id bigint [pk, increment]
  reporter_id bigint [not null]
  target_type report_target_type [not null]
  target_review_id bigint [null]
  target_user_id bigint [null]
  body varchar(1000) [not null]
  created_at datetime [not null]

  indexes {
    (reporter_id, target_review_id) [unique, name: "uq_reporter_review"]
    (reporter_id, target_user_id) [unique, name: "uq_reporter_profile"]
  }

  Note: '''
  Enforced CHECK:
  - review target => target_review_id set and target_user_id NULL;
  - profile target => target_user_id set and target_review_id NULL.
  MySQL's multiple-NULL unique behavior intentionally lets the irrelevant per-target
  unique escape enforcement. Body is full-whitespace-trimmed by the service with a
  non-empty schema backstop. Reports have no resolution/edit/withdrawal state in MVP.
  Target deletion cascades reports; moderation forensics after target deletion is an
  accepted MVP trade-off.
  '''
}

Table RECENT_SEARCH {
  id bigint [pk, increment]
  user_id bigint [not null]
  query varchar(255) [not null]
  searched_at datetime [not null]

  indexes {
    (user_id, query) [unique, name: "uq_recent_search_user_query"]
    (user_id, searched_at) [name: "ix_recent_search_user_time"]
  }

  Note: '''
  Service stores a normalized non-empty query, keeps the newest ten distinct rows per
  user, and updates searched_at when a normalized query repeats. Individual and
  clear-all removal are ordinary deletes.
  '''
}

// ---------------------------------------------------------------------------
// APP FK DELETE BEHAVIOR
// ---------------------------------------------------------------------------

Ref: USERNAME_HOLD.user_id > ONDA_USER.id [delete: cascade]
Ref: ACCOUNT_CODE.user_id > ONDA_USER.id [delete: cascade]
Ref: FOLLOW.follower_id > ONDA_USER.id [delete: cascade]
Ref: FOLLOW.followee_id > ONDA_USER.id [delete: cascade]

Ref: DIARY_ENTRY.user_id > ONDA_USER.id [delete: cascade]
Ref: DIARY_ENTRY.event_id > EVENT.id [delete: restrict]
Ref: REVIEW.entry_id > DIARY_ENTRY.id [delete: cascade]
Ref: REVIEW_LIKE.user_id > ONDA_USER.id [delete: cascade]
Ref: REVIEW_LIKE.review_id > REVIEW.id [delete: cascade]

Ref: WILL_BE_THERE.user_id > ONDA_USER.id [delete: cascade]
Ref: WILL_BE_THERE.event_id > EVENT.id [delete: restrict]

Ref: FAVORITE_EVENT.user_id > ONDA_USER.id [delete: cascade]
Ref: FAVORITE_EVENT.event_id > EVENT.id [delete: restrict]
Ref: FAVORITE_ARTIST.user_id > ONDA_USER.id [delete: cascade]
Ref: FAVORITE_ARTIST.artist_id > ARTIST.id [delete: restrict]
Ref: FAVORITE_VENUE.user_id > ONDA_USER.id [delete: cascade]
Ref: FAVORITE_VENUE.venue_id > VENUE.id [delete: restrict]

Ref: NOTIFICATION.recipient_id > ONDA_USER.id [delete: cascade]
Ref: NOTIFICATION.actor_id > ONDA_USER.id [delete: cascade]
Ref: NOTIFICATION.review_id > REVIEW.id [delete: cascade]

Ref: REPORT.reporter_id > ONDA_USER.id [delete: cascade]
Ref: REPORT.target_review_id > REVIEW.id [delete: cascade]
Ref: REPORT.target_user_id > ONDA_USER.id [delete: cascade]

Ref: RECENT_SEARCH.user_id > ONDA_USER.id [delete: cascade]

// Canonical/reference delete tripwires outside the diary/favorite cluster.
Ref: ONDA_USER.home_city_id > CITY.id [delete: restrict]
Ref: VENUE.city_id > CITY.id [delete: restrict]
Ref: EVENT.venue_id > VENUE.id [delete: restrict]
Ref: EVENT_ARTIST.event_id > EVENT.id [delete: cascade]
Ref: EVENT_ARTIST.artist_id > ARTIST.id [delete: restrict]

// ---------------------------------------------------------------------------
// VISUAL REGIONS
// ---------------------------------------------------------------------------

TableGroup INGESTION {
  TRACKED_SOURCE_PAGE
  SYNC_RUN
  RAW_INGEST
  REJECTED_INGEST
}

TableGroup CANONICAL_IDENTITY {
  CITY
  VENUE
  ARTIST
  EVENT
  EVENT_ARTIST
  EVENT_IDENTITY
  VENUE_IDENTITY
  ARTIST_IDENTITY
  CITY_IDENTITY
}

TableGroup APP {
  ONDA_USER
  USERNAME_HOLD
  ACCOUNT_CODE
  FOLLOW
  DIARY_ENTRY
  REVIEW
  REVIEW_LIKE
  WILL_BE_THERE
  FAVORITE_EVENT
  FAVORITE_ARTIST
  FAVORITE_VENUE
  NOTIFICATION
  REPORT
  RECENT_SEARCH
}
