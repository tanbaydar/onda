  FAVORITE_ARTIST -> FAVORITE_VENUE -> ONDA_USER [style=invis, weight=12];
  FAVORITE_EVENT -> WILL_BE_THERE -> DIARY_ENTRY [style=invis, weight=12];
  EVENT_IDENTITY:event_id_r:e -> EVENT:id_l:w [arrowtail="crowodot", arrowhead="tee", color="#57758d", tooltip="EVENT_IDENTITY.event_id -> EVENT.id"];
