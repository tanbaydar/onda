digraph ERD {
  graph [rankdir=LR, splines=ortho, overlap=false, outputorder=edgesfirst, bgcolor="white", pad="0.12", nodesep="0.32", ranksep="0.72", fontname="Helvetica", newrank=true];
  node [shape=plain, fontname="Helvetica", fontsize=10];
  edge [dir=both, color="#607d8b", penwidth=1.2, arrowsize=0.75];
  subgraph cluster_canonical_identity {
    label="CANONICAL + IDENTITY"; color="#3a7d44"; bgcolor="#ecf6ed"; penwidth=1.5; margin=12;
    CITY [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#263238" COLSPAN="5"><FONT COLOR="white"><B>CITY</B></FONT></TD></TR><TR><TD BGCOLOR="#ffffff" PORT="id_l" WIDTH="28">&#160;</TD><TD BGCOLOR="#ffffff" ALIGN="LEFT"><B>PK</B></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT">id</TD><TD BGCOLOR="#ffffff" ALIGN="LEFT"><FONT COLOR="#546e7a">bigint</FONT></TD><TD BGCOLOR="#ffffff" PORT="id_r" WIDTH="28">&#160;</TD></TR><TR><TD BGCOLOR="#ffffff" PORT="name_l" WIDTH="28">&#160;</TD><TD BGCOLOR="#ffffff" ALIGN="LEFT"><B>&#160;</B></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT">name</TD><TD BGCOLOR="#ffffff" ALIGN="LEFT"><FONT COLOR="#546e7a">varchar(120)</FONT></TD><TD BGCOLOR="#ffffff" PORT="name_r" WIDTH="28">&#160;</TD></TR><TR><TD BGCOLOR="#ffffff" PORT="region_code_l" WIDTH="28">&#160;</TD><TD BGCOLOR="#ffffff" ALIGN="LEFT"><B>&#160;</B></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT">region_code</TD><TD BGCOLOR="#ffffff" ALIGN="LEFT"><FONT COLOR="#546e7a">varchar(20)</FONT></TD><TD BGCOLOR="#ffffff" PORT="region_code_r" WIDTH="28">&#160;</TD></TR><TR><TD BGCOLOR="#ffffff" PORT="region_name_l" WIDTH="28">&#160;</TD><TD BGCOLOR="#ffffff" ALIGN="LEFT"><B>&#160;</B></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT">region_name</TD><TD BGCOLOR="#ffffff" ALIGN="LEFT"><FONT COLOR="#546e7a">varchar(120)</FONT></TD><TD BGCOLOR="#ffffff" PORT="region_name_r" WIDTH="28">&#160;</TD></TR><TR><TD BGCOLOR="#ffffff" PORT="country_code_l" WIDTH="28">&#160;</TD><TD BGCOLOR="#ffffff" ALIGN="LEFT"><B>&#160;</B></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT">country_code</TD><TD BGCOLOR="#ffffff" ALIGN="LEFT"><FONT COLOR="#546e7a">char(2)</FONT></TD><TD BGCOLOR="#ffffff" PORT="country_code_r" WIDTH="28">&#160;</TD></TR><TR><TD BGCOLOR="#ffffff" PORT="timezone_l" WIDTH="28">&#160;</TD><TD BGCOLOR="#ffffff" ALIGN="LEFT"><B>&#160;</B></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT">timezone</TD><TD BGCOLOR="#ffffff" ALIGN="LEFT"><FONT COLOR="#546e7a">varchar(64)</FONT></TD><TD BGCOLOR="#ffffff" PORT="timezone_r" WIDTH="28">&#160;</TD></TR></TABLE>>];
