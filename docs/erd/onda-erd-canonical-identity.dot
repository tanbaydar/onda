  FAVORITE_ARTIST:e -> ARTIST:id_r:e [arrowtail="crowodot", arrowhead="tee", color="#7c9273", style=dashed, tooltip="FAVORITE_ARTIST.artist_id -> ARTIST.id"];
  FAVORITE_VENUE:e -> VENUE:id_r:e [arrowtail="crowodot", arrowhead="tee", color="#7c9273", style=dashed, tooltip="FAVORITE_VENUE.venue_id -> VENUE.id"];
  ONDA_USER:e -> CITY:id_r:e [arrowtail="crowodot", arrowhead="odottee", color="#7c9273", style=dashed, tooltip="ONDA_USER.home_city_id -> CITY.id"];
  VENUE:city_id_r:e -> CITY:name_l:w [arrowtail="crowodot", arrowhead="tee", color="#57758d", tooltip="VENUE.city_id -> CITY.id"];
  EVENT:venue_id_r:e -> VENUE:name_l:w [arrowtail="crowodot", arrowhead="tee", color="#57758d", tooltip="EVENT.venue_id -> VENUE.id"];
  EVENT_ARTIST:event_id_r:e -> EVENT:event_date_l:w [arrowtail="crowodot", arrowhead="tee", color="#57758d", tooltip="EVENT_ARTIST.event_id -> EVENT.id"];
  EVENT_ARTIST:artist_id_r:e -> ARTIST:name_l:w [arrowtail="crowodot", arrowhead="tee", color="#57758d", tooltip="EVENT_ARTIST.artist_id -> ARTIST.id"];
