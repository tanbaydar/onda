# Copy this file to .env. Replace every change-me value before production use.
# Never commit .env.

# Public hostname only, without a scheme or path.
DANCED_DOMAIN=DANCED_DOMAIN
# Email used by Caddy for ACME certificate-expiry notices.
CADDY_ACME_EMAIL=change-me@example.invalid

# Generate with: openssl rand -base64 48
DJANGO_SECRET_KEY=change-me-generate-a-long-random-value
# The production settings module always forces DEBUG off. This remains useful locally.
DJANGO_DEBUG=false
# Keep false until a production email provider and launch flow are approved.
EMAIL_VERIFICATION_ENFORCED=false
# Console delivery is safe for the gated deployment; change only with an approved provider.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=noreply@example.invalid

# Application database and least-privilege application user.
DANCED_DB_NAME=danced
DANCED_DB_USER=danced
DANCED_DB_PASSWORD=change-me-generate-a-strong-database-password
# Root is used only by the MySQL container during first-time initialization.
DANCED_DB_ROOT_PASSWORD=change-me-generate-a-different-root-password
# Compose overrides these two values for the web container.
DANCED_DB_HOST=db
DANCED_DB_PORT=3306

# Optional locally. On EC2, set the bucket URI and region; the instance role supplies credentials.
BACKUP_BUCKET=
AWS_REGION=us-east-1
